{
    "name": "hgabka/doctrine-translatable-bundle",
    "type": "symfony-bundle",
    "description": "Integrate the doctrine-translatable extension in Symfony2",
    "keywords": [
        "doctrine2",
        "extensions",
        "translatable",
        "i18n",
        "symfony2",
        "bundle"
    ],
    "homepage": "http://hgabka.eu",
    "authors": [
        {
            "name": "Gabe"
        }
    ],
    "require": {
        "doctrine/collections": "^2.0",
        "doctrine/common": "^3.0",
        "doctrine/inflector": "^2.0",
        "doctrine/persistence": "^4.0",
        "hgabka/doctrine-translatable": "^7.1|^8.0",
        "symfony/framework-bundle": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
        "sonata-project/doctrine-orm-admin-bundle": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Hgabka\\Doctrine\\TranslatableBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hgabka\\Doctrine\\TranslatableBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev",
            "dev-v8": "8.0.x-dev"
        }
    }
}
